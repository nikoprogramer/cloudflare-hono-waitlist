{
  "name": "cloudflare-hono-waitlist",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "client": "bun run --bun astro dev",
    "build:client": "bun run --bun astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint 'src/**/*.{js,ts,tsx,astro}'",
    "worker": "wrangler dev",
    "dev": "concurrently \"bun run client\" \"bun run worker\"",
    "dryrun:staging": "bun run build:client && wrangler deploy --dry-run --env staging",
    "dryrun:prod": "bun run build:client && wrangler deploy --dry-run --env production",
    "deploy:staging": "bun run build:client && wrangler deploy --env staging",
    "deploy:prod": "bun run build:client && wrangler deploy --env production",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply blog_local_db --local",
    "db:migrate:staging": "wrangler d1 migrations apply blog_staging_db --remote --env staging",
    "create:test:db": "bun run ./scripts/create-test-db.ts",
    "destroy:test:db": "bun run ./scripts/destroy-test-db.ts",
    "test": "bun run create:test:db && bun test && bun run destroy:test:db"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.5",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.59.3",
    "astro": "^6.3.3",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.4.0",
    "eslint-plugin-astro": "^1.7.0",
    "hono": "^4.12.19",
    "jose": "^6.2.3",
    "lucide-react": "^1.16.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "wrangler": "^4.92.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260518.1",
    "@types/bun": "^1.3.14",
    "daisyui": "^5.5.19",
    "drizzle-kit": "^0.31.10",
    "drizzle-seed": "^0.3.1",
    "prettier-plugin-tailwindcss": "^0.8.0"
  }
}
